{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claude-agent-sdk-docs",
  "compatibility_date": "2026-06-24",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "docs.claude-code-sdk.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
