{
  "name": "@npm-while1/claude-agent-sdk",
  "version": "0.1.0",
  "description": "Lightweight Claude agent SDK with custom tools and streaming events",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/index.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.json",
    "test": "bun test ./src/__tests__",
    "test:integration:deepseek": "DEEPSEEK_MODEL=${DEEPSEEK_MODEL:-deepseek-v4-flash} bun test ./src/__tests__/integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
