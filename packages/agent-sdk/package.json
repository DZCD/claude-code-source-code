{
  "name": "agent-lattice",
  "version": "0.13.0",
  "description": "AgentLattice framework for coordinated agent systems with tools, tracing, and teams",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepublishOnly": "bun run build",
    "pack:dry-run": "bun run build && npm pack --dry-run",
    "test": "bun test ./src/__tests__",
    "test:integration:deepseek": "DEEPSEEK_MODEL=${DEEPSEEK_MODEL:-deepseek-v4-flash} bun test ./src/__tests__/integration.test.ts",
    "docs:deploy": "cd ../docs && bun run deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "langsmith": "0.7.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "javascript-obfuscator": "^5.4.1",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
